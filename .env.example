# Shiksha AI Environment Variables
# Last Updated: 2026-02-22

# Backend API URL (for online mode)
EXPO_PUBLIC_API_URL=https://shikshaai-backend.vercel.app

# For local development, use:
# EXPO_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# S3 Model Bucket URL (for on-device AI model download)
# ---------------------------------------------------------------------------
# The GGUF model file is hosted on S3. On first launch, the app downloads it
# to the phone's local storage and then runs it 100% offline via llama.cpp.
#
# Current bucket structure:
#   s3://shiksha-ai-models-rushikesh4537/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
#
# Public download URL:
#   https://shiksha-ai-models-rushikesh4537.s3.eu-north-1.amazonaws.com/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
#
# If not set, the default in code points to this bucket.
# Override only if you move models to a different bucket/CDN.
EXPO_PUBLIC_MODEL_BASE_URL=https://shiksha-ai-models-rushikesh4537.s3.eu-north-1.amazonaws.com

# ---------------------------------------------------------------------------
# Supabase Configuration (for Cloud Synchronization)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
